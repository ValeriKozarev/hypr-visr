				<string>/usr/bin/python3 -c '
import json, sys, uuid, os

tasks_file = os.path.expanduser("~/.hypr-visr/tasks.json")
title = sys.argv[1]

try:
    with open(tasks_file) as f:
        data = json.load(f)

    task = {"id": str(uuid.uuid4()), "title": title, "isDone": False}

    if data.get("lists"):
        data["lists"][0]["tasks"].insert(0, task)
        with open(tasks_file, "w") as f:
            json.dump(data, f, indent=2)
        print(title)
    else:
        print("Error: No lists found in hypr-visr")
        sys.exit(1)
except FileNotFoundError:
    print("Error: hypr-visr data file not found. Open hypr-visr first.")
    sys.exit(1)
except Exception as e:
    print("Error: " + str(e))
    sys.exit(1)
